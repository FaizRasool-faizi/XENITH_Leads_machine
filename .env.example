# XENITH Lead Generator Environment Configuration
# All settings default to safe, local, free values.

APP_NAME="XENITH Lead Generator"
COMPANY_NAME="XENITH Solutions"
DATABASE_URL="sqlite:///data/xenith_leads.db"

# Crawler Safety Settings
REQUEST_TIMEOUT_SECONDS=10
MAX_RESPONSE_BYTES=2097152
RATE_LIMIT_SECONDS=1.0

# Optional Local AI (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3:latest"
OLLAMA_ENABLED=false
